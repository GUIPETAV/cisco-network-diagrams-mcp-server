{
  "name": "cisco-network-diagrams-mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing the 308 official Cisco Systems Corporate Iconography icons (RGB-fixed) for building network topology diagrams.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cisco-network-diagrams-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cisco",
    "network-diagram",
    "topology",
    "icons"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GUIPETAV/cisco-network-diagrams-mcp-server.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
